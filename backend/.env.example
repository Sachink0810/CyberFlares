# ─────────────────────────────────────────────────────────────
# CyberFlares backend environment — Docker Compose defaults.
# Copy to backend/.env before first `docker compose up`.
# ─────────────────────────────────────────────────────────────

# Redis (broker + result backend + custom job KV)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# PostGIS
POSTGRES_DSN=postgresql://cyberflares:cyberflares@postgis:5432/cyberflares

# MinIO (S3-compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cfadmin
MINIO_SECRET_KEY=cfadmincfadmin
MINIO_SECURE=false
MINIO_BUCKET=cyberflares

# SPH execution mode:
#   external — stage inputs for the GPU laptop, wait for VTK upload
#   local    — subprocess-run GenCase + DualSPHysics5.2CUDA here
SPH_MODE=external
DUALSPHYSICS_BIN_DIR=

# Delft3D FM binary (leave blank → skipped)
DFLOWFM_BIN=

# Google Earth Engine service account
GEE_SERVICE_ACCOUNT=
GEE_KEY_JSON=

# CORS (browser → api goes through nginx as same-origin, but keep permissive for dev)
CF_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1
